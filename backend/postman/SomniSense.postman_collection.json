    {
      "name": "07 Ingestion (machine)",
      "description": "Machine-to-machine: X-Ingestion-Key, NOT the staff login. See docs/api/INGESTION.md.",
      "item": [
        {
          "name": "Send readings WITHOUT key (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingestion/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingestion",
                "readings"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceCode\": \"{{deviceCode}}\",\n  \"readings\": [\n    {\n      \"readingKey\": \"x\",\n      \"measuredAt\": \"2026-01-01T00:00:00Z\",\n      \"spo2\": 96,\n      \"heartRate\": 67\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('code UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send readings (2 good + dropout + 1 out of range)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Ingestion-Key",
                "value": "{{ingestionKey}}",
                "description": "Machine key from INGESTION_API_KEY (environment secret)."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingestion/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingestion",
                "readings"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{{readingsBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Builds a batch with timestamps a few seconds in the past and keeps it for the 'resend' request.",
                  "const now = Date.now();",
                  "const iso = (msAgo) => new Date(now - msAgo).toISOString();",
                  "const run = pm.collectionVariables.get('runId');",
                  "const body = { deviceCode: pm.collectionVariables.get('deviceCode'), readings: [",
                  "  { readingKey: `pm-${run}-1`, measuredAt: iso(4000), spo2: 97, heartRate: 68 },",
                  "  { readingKey: `pm-${run}-2`, measuredAt: iso(3000), spo2: 95.5, heartRate: 70 },",
                  "  { readingKey: `pm-${run}-3`, measuredAt: iso(2000), spo2: null, heartRate: null },",
                  "  { readingKey: `pm-${run}-4`, measuredAt: iso(1000), spo2: 150, heartRate: 66 } ] };",
                  "pm.collectionVariables.set('readingsBody', JSON.stringify(body, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('3 accepted', () => pm.expect(j.accepted).to.eql(3));",
                  "pm.test('out-of-range rejected, not clamped', () => pm.expect(j.rejected[0].reason).to.eql('SPO2_OUT_OF_RANGE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend the SAME batch (retry is safe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Ingestion-Key",
                "value": "{{ingestionKey}}",
                "description": "Machine key from INGESTION_API_KEY (environment secret)."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingestion/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingestion",
                "readings"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{{readingsBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('nothing stored twice', () => { pm.expect(j.accepted).to.eql(0); pm.expect(j.duplicates).to.eql(3); });"
                ]
              }
            }
          ]
        }
      ]
    },
