          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
