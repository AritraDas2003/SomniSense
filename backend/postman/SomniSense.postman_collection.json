                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('same assignment', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('assignmentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate ASSIGNED device (expect 409)",
          "request": {
            "method": "POST",
