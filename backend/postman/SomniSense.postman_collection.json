                  "const row = pm.response.json().content[0];",
                  "pm.test('device, session and latest reading', () => { pm.expect(row.currentDevice.deviceCode).to.eql(pm.collectionVariables.get('deviceCode')); pm.expect(row.activeSession.sessionCode).to.eql(pm.collectionVariables.get('sessionCode')); pm.expect(row.latestReading).to.have.property('measuredAt'); });"
