{
  "info": {
    "name": "SomniSense Backend API",
    "description": "SomniSense Spring Boot backend - first milestone (Stages 1-9).\nRun the folders IN ORDER (Collection Runner): each request stores the IDs the next one needs.\n\nSetup: import \"SomniSense-Local.postman_environment.json\", select it, and fill the SECRET values\nadminPassword (SOMNISENSE_ADMIN_PASSWORD from backend/.env) and ingestionKey (INGESTION_API_KEY).\nNo passwords or keys are stored in this collection.\n\nEducational prototype: model/readings here are SYNTHETIC test data, not clinical data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "xsrfToken",
      "value": ""
    },
    {
      "key": "adminUserId",
      "value": ""
    },
    {
      "key": "createdUserId",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "patientCode",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "deviceCode",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "sessionCode",
      "value": ""
    },
    {
      "key": "readingsBody",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "description": "Public. No login needed.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "description": "Session-cookie login with CSRF. See docs/api/AUTH.md.",
      "item": [
        {
          "name": "CSRF token (before login)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "csrf"
              ]
            },
            "description": "Stores the current CSRF token in {{xsrfToken}}. A browser does this via the XSRF-TOKEN cookie automatically; Postman needs this step (also after login, because login issues a NEW token)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xsrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login WITHOUT CSRF header (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('code CSRF_TOKEN_INVALID', () => pm.expect(pm.response.json().code).to.eql('CSRF_TOKEN_INVALID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with WRONG password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"definitely-not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('code INVALID_CREDENTIALS', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "adminLogin / adminPassword come from the environment (password is a SECRET value, never exported).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('role ADMIN', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));",
                  "pm.test('no password in response', () => pm.expect(pm.response.text()).to.not.include('password'));",
                  "pm.collectionVariables.set('adminUserId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CSRF token (after login)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "csrf"
              ]
            },
            "description": "Stores the current CSRF token in {{xsrfToken}}. A browser does this via the XSRF-TOKEN cookie automatically; Postman needs this step (also after login, because login issues a NEW token)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xsrfToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('admin', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('adminUserId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Users (Admin)",
      "description": "ADMIN only. See docs/api/USERS.md.",
      "item": [
        {
          "name": "Create Operator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "The backend generates a one-time temporaryPassword (shown once). This collection does NOT store it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ops.{{runId}}\",\n  \"email\": \"ops.{{runId}}@demo.local\",\n  \"role\": \"OPERATOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('temporary password returned once', () => pm.expect(j.temporaryPassword).to.match(/^[A-Za-z0-9]{16}$/));",
                  "pm.collectionVariables.set('createdUserId', j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?role=OPERATOR&size=5&sort=createdAt&direction=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "OPERATOR"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "createdAt"
                },
                {
                  "key": "direction",
                  "value": "desc"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('page shape', () => pm.expect(pm.response.json()).to.have.keys('content','page','size','totalElements','totalPages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate MYSELF (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{adminUserId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{adminUserId}}",
                "deactivate"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code SELF_ACTION_NOT_ALLOWED', () => pm.expect(pm.response.json().code).to.eql('SELF_ACTION_NOT_ALLOWED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Patients",
      "description": "ADMIN + OPERATOR. See docs/api/PATIENTS.md.",
      "item": [
        {
          "name": "Register SIMULATED patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Demo Patient {{runId}}\",\n  \"alias\": \"PM-{{runId}}\",\n  \"gender\": \"UNDISCLOSED\",\n  \"sourceType\": \"SIMULATED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('backend-generated code', () => pm.expect(j.patientCode).to.match(/^PT-[2-9A-HJ-NP-Z]{8}$/));",
                  "pm.collectionVariables.set('patientId', j.id); pm.collectionVariables.set('patientCode', j.patientCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register INVALID patient (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alias\": \"no name, no source\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code VALIDATION_FAILED', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED'));",
                  "pm.test('field errors', () => pm.expect(pm.response.json().fieldErrors.map(f => f.field)).to.include.members(['fullName','sourceType']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find patient by code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients?q={{patientCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{patientCode}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('found', () => pm.expect(pm.response.json().totalElements).to.eql(1));",
                  "pm.test('list hides medical data', () => pm.expect(pm.response.json().content[0]).to.not.have.property('medicalDetails'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save medical details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/medical-details",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "{{patientId}}",
                "medical-details"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Synthetic demo record - not a real person\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('saved', () => pm.expect(pm.response.json().medicalDetails.notes).to.include('Synthetic'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Devices",
      "description": "ADMIN + OPERATOR (deactivate: ADMIN). See docs/api/DEVICES.md.",
      "item": [
        {
          "name": "Register SIMULATED device (code generated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceType\": \"SIMULATED\",\n  \"modelName\": \"Postman virtual oximeter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('generated code', () => pm.expect(j.deviceCode).to.match(/^DEV-/));",
                  "pm.test('simulated starts ENROLLED', () => pm.expect(j.enrollmentStatus).to.eql('ENROLLED'));",
                  "pm.test('never seen yet', () => pm.expect(j.connectivityStatus).to.eql('UNKNOWN'));",
                  "pm.collectionVariables.set('deviceId', j.id); pm.collectionVariables.set('deviceCode', j.deviceCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register DUPLICATE code (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}",
                "description": "Required on POST/PUT/PATCH/DELETE (CSRF). Filled by the \"CSRF token\" requests."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceCode\": \"{{deviceCode}}\",\n  \"deviceType\": \"SIMULATED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code CONFLICT', () => pm.expect(pm.response.json().code).to.eql('CONFLICT'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Device assignments",
      "description": "See docs/api/ASSIGNMENTS.md.",
      "item": [
