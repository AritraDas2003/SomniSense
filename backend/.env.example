# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit real passwords.

# --- Database (required) ---
DB_PASSWORD=change-me
# Optional overrides (defaults shown in application.properties)
# DB_URL=jdbc:postgresql://localhost:5432/somnisense_db
# DB_USERNAME=postgres

# --- First ADMIN account (required once) ---
# Created at startup ONLY while the users table is empty. Username: 3-50 chars a-z 0-9 . _ -
# Password: 12-72 characters.
SOMNISENSE_ADMIN_USERNAME=admin
SOMNISENSE_ADMIN_EMAIL=admin@example.local
SOMNISENSE_ADMIN_PASSWORD=change-me-to-12-plus-chars

# --- Session / browser access (optional; defaults shown) ---
# SESSION_TIMEOUT=60m
# SESSION_COOKIE_SECURE=false        # true when served over HTTPS
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Test database (used by `mvnw test`) ---
# TEST_DB_URL=jdbc:postgresql://localhost:5432/somnisense_test_db

# --- Reading ingestion (required to accept readings) ---
# Shared secret the simulator / trusted gateway sends in the X-Ingestion-Key header. At least 32 characters.
INGESTION_API_KEY=change-me-to-a-random-string-of-32-plus-characters

# --- Internal Model C FastAPI Sidecar (Stage 3) ---
# AI_SERVICE_BASE_URL=http://127.0.0.1:8090
AI_SERVICE_API_KEY=change-me-to-an-internal-ai-key-of-32-plus-chars

# --- Internal Simulator Worker (Stage 4) ---
# SIM_WORKER_BASE_URL=http://127.0.0.1:8095
# SIM_INGESTION_BASE_URL=http://127.0.0.1:8080
SIM_WORKER_INTERNAL_KEY=change-me-to-an-internal-sim-key-of-32-plus-chars
