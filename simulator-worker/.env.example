# Internal FastAPI key shared with Spring Boot (minimum 32 characters)
SIM_WORKER_INTERNAL_KEY=change-me-to-an-internal-sim-key-of-32-plus-chars

# Ingestion key shared with Spring Boot /api/v1/ingestion/readings (minimum 32 characters)
INGESTION_API_KEY=change-me-to-a-random-string-of-32-plus-characters

# Default Spring Boot ingestion base URL (can also be overridden per command)
BACKEND_BASE_URL=http://127.0.0.1:8080

# Worker bind address & batching tuning
SIM_WORKER_HOST=127.0.0.1
SIM_WORKER_PORT=8095
SIM_BATCH_SIZE=5
SIM_FLUSH_INTERVAL_SECONDS=1.0
SIM_HTTP_TIMEOUT_SECONDS=5.0
SIM_MAX_INGEST_RETRIES=5
